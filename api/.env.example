# Copiar para .env e preencher. O ficheiro .env NUNCA vai para o Git.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/do-campo-a-mesa
JWT_SECRET=trocar-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=2h
# Origem da SPA (CORS e Socket.io)
CLIENT_URL=http://localhost:5173
# Local em desenvolvimento. No Render, usar cloudinary e preencher CLOUDINARY_URL no painel.
IMAGENS_ARMAZENAMENTO=local
CLOUDINARY_URL=
CICLO_LEILOES_ATIVO=true
